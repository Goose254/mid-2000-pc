{
  "name": "mid-2000-pc",
  "private": true,
  "version": "1.0.0",
  "description": "A nostalgic simulation of a mid-2000s Windows XP PC running in the browser — BIOS, boot screen, desktop, windows and classic apps.",
  "author": "Vincent Douay",
  "contributors": [
    "Florian Douay"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Goose254/mid-2000-pc.git"
  },
  "homepage": "https://mid-2000-pc.douay.me",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-expose": "vite --host",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.2",
    "i18next": "^24.2.2",
    "i18next-browser-languagedetector": "^8.0.4",
    "lucide-react": "^0.344.0",
    "overlayscrollbars": "^2.10.1",
    "overlayscrollbars-react": "^0.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.1",
    "react-tabs": "^6.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "sass": "^1.83.4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
